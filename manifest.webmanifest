{
  "id": "./",
  "name": "Contas Wesley",
  "short_name": "Contas",
  "description": "Controle financeiro pelo ciclo do salário.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f5f7fb",
  "theme_color": "#f5f7fb",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Novo gasto", "short_name": "Gasto", "url": "./?acao=gasto",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Ler boleto ou Pix", "short_name": "Ler código", "url": "./?acao=ler",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Lançar falando", "short_name": "Falar", "url": "./?acao=voz",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Agenda do ciclo", "short_name": "Agenda", "url": "./?pag=agenda",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "arquivo", "accept": ["image/*"] }]
    }
  }
}
